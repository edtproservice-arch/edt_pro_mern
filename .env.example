# Copier en backend/.env et renseigner. NE JAMAIS COMMITTER le .env réel.
# Les secrets de l'application PHP sont compromis (présents dans l'historique
# Git) : générer de NOUVELLES valeurs ici, ne pas les recopier.

NODE_ENV=development
PORT=4000

# MongoDB — replica set requis, même mono-nœud (transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/gestion_edt?replicaSet=rs0

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# En production : .edtpro.ma  (cookie partagé pendant la coexistence PHP/Node)
COOKIE_DOMAIN=
# Pour un frontend hébergé sur une autre origine : none
COOKIE_SAME_SITE=lax

# Origines frontend autorisées, séparées par des virgules.
HTTP_ORIGINES=http://localhost:5173
# Même liste pour la collaboration WebSocket.
WS_ORIGINES=http://localhost:5173

SMTP_HOST=smtp.stackmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optionnel — assistant IA (F16)
GEMINI_API_KEY=
