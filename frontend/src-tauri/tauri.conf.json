{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDT Pro",
  "version": "0.1.0",
  "identifier": "ma.edtpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EDT Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJERTI3OEE3QzA0RkJCNDgKUldSSXUwL0FwM2ppTFl5WitZeGlXaUNiRGtGai9PWG5lZGtRUXpNMVBzZzVvZWkrcittV1FxZGMK",
      "endpoints": [
        "https://github.com/edtproservice-arch/edt_pro_mern/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
